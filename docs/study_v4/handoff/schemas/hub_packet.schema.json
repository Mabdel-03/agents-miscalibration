{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approach",
    "claims",
    "checks",
    "source_packet_ids"
  ],
  "properties": {
    "approach": {
      "type": "string",
      "maxLength": 8192
    },
    "claims": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "source_packet_ids": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    }
  },
  "$comment": "Rendered packet must fit2048 recipient tokens. Provenance handles refer only to allowed peer packets."
}
