{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete original-task candidate; native reasoning is parsed separately",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approach",
    "evidence",
    "alternatives_considered",
    "failure_checks",
    "final_answer",
    "confidence"
  ],
  "properties": {
    "approach": {
      "type": "string",
      "maxLength": 16384
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "support",
          "uncertainty"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 8192
          },
          "support": {
            "type": "string",
            "maxLength": 8192
          },
          "uncertainty": {
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          }
        }
      }
    },
    "alternatives_considered": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "failure_checks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "final_answer": {
      "type": "string",
      "maxLength": 131072
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
