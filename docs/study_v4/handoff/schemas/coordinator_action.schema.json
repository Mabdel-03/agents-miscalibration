{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "candidate"
      ],
      "properties": {
        "action": {
          "const": "final"
        },
        "candidate": {
          "title": "Complete original-task candidate; native reasoning is parsed separately",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approach",
            "evidence",
            "alternatives_considered",
            "failure_checks",
            "final_answer",
            "confidence"
          ],
          "properties": {
            "approach": {
              "type": "string",
              "maxLength": 16384
            },
            "evidence": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "claim",
                  "support",
                  "uncertainty"
                ],
                "properties": {
                  "claim": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "support": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "uncertainty": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "unknown"
                    ]
                  }
                }
              }
            },
            "alternatives_considered": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "failure_checks": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "final_answer": {
              "type": "string",
              "maxLength": 131072
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "assignments"
      ],
      "properties": {
        "action": {
          "const": "delegate"
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "worker_slot",
              "subtask_id",
              "question",
              "source_handles",
              "required_output_type",
              "return_contract"
            ],
            "properties": {
              "worker_slot": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "subtask_id": {
                "type": "string",
                "maxLength": 128
              },
              "question": {
                "type": "string",
                "maxLength": 8192
              },
              "source_handles": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "maxLength": 8192
                }
              },
              "required_output_type": {
                "type": "string",
                "maxLength": 256
              },
              "return_contract": {
                "type": "string",
                "maxLength": 8192
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Cross-record validator enforces unique worker slots <= N_total-1 and allowed handles."
}
