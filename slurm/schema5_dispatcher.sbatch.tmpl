#!/bin/bash
# This file is rendered once for one rollout generation.  Never edit a rendered copy.
#SBATCH --job-name={JOB_NAME}
#SBATCH --comment={JOB_TOKEN}
#SBATCH --partition={PARTITION}
#SBATCH --cpus-per-task=1
#SBATCH --mem={MEMORY}
#SBATCH --time={TIME_LIMIT}
#SBATCH --no-requeue
#SBATCH --output={LOG_PATH}
#SBATCH --mail-user={ALERT_EMAIL}
#SBATCH --mail-type=FAIL

set -euo pipefail
unset PYTHONHOME PYTHONPATH VIRTUAL_ENV CONDA_PREFIX CONDA_DEFAULT_ENV

export PYTHONDONTWRITEBYTECODE=1
export PYTHONNOUSERSITE=1
export PYTHONSAFEPATH=1

export ASYS_RELEASE_ID="{RELEASE_ID}"
export ASYS_RELEASE_WORKTREE="{RELEASE_WORKTREE}"
export ASYS_MODEL_CONTRACT_SHA256="{MODEL_CONTRACT_SHA256}"
export ASYS_FLEET_CONTRACT_SHA256="{FLEET_CONTRACT_SHA256}"
export ASYS_HARNESS_ENVIRONMENT_SHA256="{HARNESS_ENVIRONMENT_SHA256}"
export ASYS_SERVING_ENVIRONMENT_SHA256="{SERVING_ENVIRONMENT_SHA256}"
export ASYS_ROLLOUT_GENERATION="{ROLLOUT_GENERATION}"
export ASYS_IMMUTABLE_PINS_SHA256="{IMMUTABLE_PINS_SHA256}"
export HF_HOME="{HF_HOME}"
export ASYS_RESULTS_ROOT="{RESULTS_ROOT}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1

exec "{PYTHON}" -u "{CONTROL_SCRIPT}" --state-dir "{STATE_DIR}" supervise \
  --role dispatcher --generation {GENERATION} --intent-token "{INTENT_TOKEN}"
