#!/bin/bash
#SBATCH --job-name={JOB_NAME}
#SBATCH --comment=asys-schema5-pool:{SERVER_POOL_ID};profile={PROFILE_NAME};replica={REPLICA_ID}
#SBATCH --partition={PARTITION}
{QOS_LINE}#SBATCH --gres=gpu:{GPU_TYPE}:{TP_SIZE}
#SBATCH --cpus-per-task={CPUS}
#SBATCH --mem={MEM}
#SBATCH --time={TIME}
#SBATCH --output={LOG_DIR}/serve_{PROFILE_NAME}_%j.out
#SBATCH --mail-user=mabdel03@mit.edu
#SBATCH --mail-type=FAIL
#SBATCH --no-requeue
#SBATCH --export=NONE

set -euo pipefail
umask 027
unset BASH_ENV CDPATH ENV LD_AUDIT LD_LIBRARY_PATH LD_PRELOAD
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_ATTR_NOSYSTEM GIT_CEILING_DIRECTORIES
unset GIT_COMMON_DIR GIT_CONFIG GIT_CONFIG_COUNT GIT_CONFIG_GLOBAL
unset GIT_CONFIG_NOSYSTEM GIT_CONFIG_PARAMETERS GIT_CONFIG_SYSTEM GIT_DIR
unset GIT_DISCOVERY_ACROSS_FILESYSTEM GIT_EXEC_PATH GIT_INDEX_FILE GIT_NAMESPACE
unset GIT_NO_REPLACE_OBJECTS GIT_OBJECT_DIRECTORY GIT_REPLACE_REF_BASE
unset GIT_SHALLOW_FILE GIT_SSH GIT_SSH_COMMAND GIT_TEMPLATE_DIR GIT_WORK_TREE
unset SLURM_CLUSTERS SLURM_CONF SLURM_EXIT_ERROR SLURM_TIME_FORMAT
while IFS= read -r ambient_name; do
  case "$ambient_name" in
    ASYS_*|BASH_FUNC_*|PIP_*|PYTHON*|CONDA_*|HF_*|TRANSFORMERS_*|VLLM_*|GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*|GIT_TRACE*|SACCT_*|SBATCH_*|SCONTROL_*|SQUEUE_*)
      builtin unset -v "$ambient_name" 2>/dev/null || true
      ;;
  esac
done < <(compgen -e)
export PATH=/usr/bin:/bin
readonly PATH
while read -r _ _ ambient_function; do
  builtin unset -f "$ambient_function"
done < <(builtin declare -F)
export LANG=C LC_ALL=C
export GIT_ATTR_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 GIT_TERMINAL_PROMPT=0
export GIT_PAGER=cat PAGER=cat
unset PYTHONHOME VIRTUAL_ENV CONDA_PREFIX CONDA_DEFAULT_ENV LD_LIBRARY_PATH LD_PRELOAD
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export PYTHONDONTWRITEBYTECODE=1
export PYTHONNOUSERSITE=1
export PYTHONPATH=
export ASYS_RELEASE_ID="{RELEASE_ID}"
export ASYS_RELEASE_WORKTREE="{RELEASE_WORKTREE}"
export ASYS_MODEL_CONTRACT="{MODEL_CONTRACT_PATH}"
export ASYS_MODEL_CONTRACT_SHA256="{MODEL_CONTRACT_SHA256}"
export ASYS_FLEET_CONTRACT_SHA256="{FLEET_CONTRACT_SHA256}"
export ASYS_RELEASE_FLEET_CONTRACT_SHA256="{RELEASE_FLEET_CONTRACT_SHA256}"
export ASYS_CAPACITY_GENERATION="{CAPACITY_GENERATION}"
export ASYS_HARNESS_ENVIRONMENT_SHA256="{HARNESS_ENVIRONMENT_HASH}"
export ASYS_SERVING_ENVIRONMENT_SHA256="{ENVIRONMENT_HASH}"
export ASYS_RUNTIME_ATTESTATION="{RUNTIME_ATTESTATION}"
export ASYS_RUNTIME_ATTESTATION_SHA256="{RUNTIME_ATTESTATION_SHA256}"
export ASYS_RUNTIME_INTEGRITY_LEASE="{RUNTIME_INTEGRITY_LEASE}"
export ASYS_IMMUTABLE_PINS_SHA256="{IMMUTABLE_PINS_SHA256}"
export ASYS_ROLLOUT_GENERATION="{ROLLOUT_GENERATION}"
export HF_HOME="{HF_HOME}"
# study-v4 patch C: compile/kernel caches on NODE-LOCAL /tmp (never $HOME: file quota ~85%;
# never NFS: TP>1 ranks racing on one inductor autotune dir gave "Stale file handle").
ASYS_LOCAL_CACHE="/tmp/asys_srv_${SLURM_JOB_ID}"
mkdir -p "$ASYS_LOCAL_CACHE"/{vllm,torchinductor,triton,xdg}
trap 'rm -rf "$ASYS_LOCAL_CACHE"' EXIT
export XDG_CACHE_HOME="$ASYS_LOCAL_CACHE/xdg"
export VLLM_CACHE_ROOT="$ASYS_LOCAL_CACHE/vllm"
export TORCHINDUCTOR_CACHE_DIR="$ASYS_LOCAL_CACHE/torchinductor"
export TRITON_CACHE_DIR="$ASYS_LOCAL_CACHE/triton"
# The env scrub above removed any CUDA toolchain; FlashInfer's JIT sampler needs nvcc.
# Use the native PyTorch top-k/top-p sampler instead (no JIT), and expose a matching
# CUDA 13 toolkit in case another JIT path needs it.
export VLLM_USE_FLASHINFER_SAMPLER=0
export CUDA_HOME="/orcd/software/core/001/pkg/cuda/13.0.1"
export VLLM_NO_USAGE_STATS=1
export DO_NOT_TRACK=1
export TOKENIZERS_PARALLELISM=false

# Revalidate after Slurm starts the allocation.  A server may remain pending long
# after its launch intent was rendered.  The controller-refreshed, generation-bound
# lease proves that a complete metadata scan was recent before vLLM executes.
if [ "{PRODUCTION_RUNTIME}" = "1" ]; then
  LD_LIBRARY_PATH="{HARNESS_PREFIX}/lib" "{HARNESS_PYTHON}" -I -m \
    agents_scaling.runtime_integrity \
    --lease "{RUNTIME_INTEGRITY_LEASE}" \
    --attestation "{RUNTIME_ATTESTATION}" \
    --attestation-sha256 "{RUNTIME_ATTESTATION_SHA256}" \
    --generation {ROLLOUT_GENERATION} \
    --release-id "{RELEASE_ID}" \
    --immutable-pins-sha256 "{IMMUTABLE_PINS_SHA256}" \
    --environment-hash "harness={HARNESS_ENVIRONMENT_HASH}" \
    --environment-hash "serving={ENVIRONMENT_HASH}" \
    --environment-prefix "harness={HARNESS_PREFIX}" \
    --environment-prefix "serving={SERVING_PREFIX}"
fi

# Run both probes with the exact immutable interpreters.  In schema-5 production the
# expected versions come directly from the checksummed environment manifests; no shell
# activation, user site, or ambient PYTHONPATH participates in either runtime.
LD_LIBRARY_PATH="{SERVING_PREFIX}/lib" "{SERVING_PYTHON}" -I - \
  "{SERVING_PREFIX}" \
  "{SERVING_PYTHON_VERSION}" \
  "{SERVING_VLLM_VERSION}" \
  "{SERVING_TRANSFORMERS_VERSION}" \
  "{SERVING_TOKENIZERS_VERSION}" \
  "{SERVING_TORCH_VERSION}" \
  "{SERVING_CUDA_VERSION}" \
  "{PRODUCTION_RUNTIME}" <<'PY'
import importlib.metadata
import os
import platform
from pathlib import Path
import sys

prefix, python_v, vllm_v, transformers_v, tokenizers_v, torch_v, cuda_v, production = sys.argv[1:]
assert Path(sys.prefix).resolve() == Path(prefix).resolve(), (sys.prefix, prefix)
assert os.environ.get("PYTHONPATH", "") == ""
assert os.environ.get("LD_LIBRARY_PATH") == str(Path(prefix) / "lib")
assert importlib.metadata.version("vllm") == "0.21.0"
if production == "1":
    assert platform.python_version() == python_v
    assert importlib.metadata.version("vllm") == vllm_v
    assert importlib.metadata.version("transformers") == transformers_v
    assert importlib.metadata.version("tokenizers") == tokenizers_v
    assert importlib.metadata.version("torch") == torch_v
    import torch
    assert str(torch.version.cuda) == cuda_v
PY

LD_LIBRARY_PATH="{HARNESS_PREFIX}/lib" "{HARNESS_PYTHON}" -I - \
  "{HARNESS_PREFIX}" \
  "{HARNESS_PYTHON_VERSION}" \
  "{HARNESS_TRANSFORMERS_VERSION}" \
  "{HARNESS_TOKENIZERS_VERSION}" \
  "{PRODUCTION_RUNTIME}" <<'PY'
import importlib.metadata
import os
import platform
from pathlib import Path
import sys

prefix, python_v, transformers_v, tokenizers_v, production = sys.argv[1:]
resolved_prefix = Path(prefix).resolve()
assert Path(sys.prefix).resolve() == resolved_prefix, (sys.prefix, prefix)
assert os.environ.get("PYTHONPATH", "") == ""
assert os.environ.get("LD_LIBRARY_PATH") == str(resolved_prefix / "lib")
if production == "1":
    assert platform.python_version() == python_v
    assert importlib.metadata.version("transformers") == transformers_v
    assert importlib.metadata.version("tokenizers") == tokenizers_v
    import agents_scaling
    Path(agents_scaling.__file__).resolve().relative_to(resolved_prefix)
PY

# study-v4: /home/<user> is an autofs symlink to /orcd/home/... on some nodes and a direct mount on
# others, so no path-string comparison is portable. The vllm entry point is executed through the
# pinned serving interpreter below (its installed shebang is never consulted); just check it exists.
test -s "{VLLM_EXECUTABLE}"

PORT={PORT}
echo "[serve] profile={PROFILE_NAME} model={HF_ID} tp={TP_SIZE} context={MAX_MODEL_LEN} port=$PORT node=$(hostname) job=$SLURM_JOB_ID"

# Start vLLM in the background, then register + healthcheck, then wait on it.
LD_LIBRARY_PATH="{SERVING_PREFIX}/lib" \
"{SERVING_PYTHON}" "{VLLM_EXECUTABLE}" serve "{HF_ID}" \
  --revision "{MODEL_REVISION}" \
  --tokenizer "{TOKENIZER_ID}" \
  --tokenizer-revision "{TOKENIZER_REVISION}" \
  --served-model-name "{SERVED_MODEL_NAME}" \
  --tensor-parallel-size {TP_SIZE} \
  --gpu-memory-utilization 0.90 \
  --max-model-len {MAX_MODEL_LEN} \
  --max-logprobs 20 \
  --reasoning-parser qwen3 \
  --max-num-seqs 64 \
  --port "$PORT" &
VLLM_PID=$!
# Note: vLLM>=0.21 logs requests OFF by default (use --enable-log-requests to turn on);
# the old --disable-log-requests flag was removed.

# Wait for readiness, then publish the endpoint to the registry so cell jobs can find it.
# Registration uses the separately frozen harness interpreter.
LD_LIBRARY_PATH="{HARNESS_PREFIX}/lib" \
"{HARNESS_PYTHON}" -I -m agents_scaling.serving.launch_server --register \
{STANDBY_LINE}\
  --run-root "{RUN_ROOT}" \
  --server-pool-id "{SERVER_POOL_ID}" \
  --replica-id "{REPLICA_ID}" \
  --replica-index {REPLICA_INDEX} \
  --model-size "{MODEL_SIZE}" \
  --profile "{PROFILE_NAME}" \
  --hf-id "{HF_ID}" \
  --model-revision "{MODEL_REVISION}" \
  --tokenizer-id "{TOKENIZER_ID}" \
  --tokenizer-revision "{TOKENIZER_REVISION}" \
  --release-worktree "{RELEASE_WORKTREE}" \
  --model-contract "{MODEL_CONTRACT_PATH}" \
  --model-contract-sha256 "{MODEL_CONTRACT_SHA256}" \
  --fleet-contract "{FLEET_CONTRACT_PATH}" \
  --fleet-contract-sha256 "{FLEET_CONTRACT_SHA256}" \
  --release-fleet-contract-sha256 "{RELEASE_FLEET_CONTRACT_SHA256}" \
  --capacity-generation {CAPACITY_GENERATION} \
  --rollout-generation {ROLLOUT_GENERATION} \
  --release-id "{RELEASE_ID}" \
  --environment-hash "{ENVIRONMENT_HASH}" \
  --served-model-name "{SERVED_MODEL_NAME}" \
  --max-model-len {MAX_MODEL_LEN} \
  --tp-size {TP_SIZE} \
  --port "$PORT"

echo "[serve] registered and healthy; serving until job time limit or cancellation"
wait "$VLLM_PID"
