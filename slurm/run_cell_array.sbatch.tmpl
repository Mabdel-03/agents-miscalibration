#!/bin/bash
#SBATCH --job-name=asys-cells
#SBATCH --partition={PARTITION}
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time={TIME}
#SBATCH --array=0-{LAST_INDEX}%{THROTTLE}
#SBATCH --output={LOG_DIR}/cell_%A_%a.out

set -euo pipefail
source "{REPO}/slurm/common.sh"
mamba activate asys_env

# Cell jobs are HTTP clients to the vLLM servers (no GPU needed here).
python -m agents_scaling.experiment.run_one \
  --run-id "{RUN_ID}" \
  --cells-file "{CELLS_FILE}" \
  --index "$SLURM_ARRAY_TASK_ID"
