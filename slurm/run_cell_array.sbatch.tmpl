#!/bin/bash
#SBATCH --job-name=asys-cells
#SBATCH --partition={PARTITION}
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=12:00:00
#SBATCH --array=0-{LAST_INDEX}%{THROTTLE}
#SBATCH --output={LOG_DIR}/cell_%A_%a.out
#SBATCH --signal=B:USR1@1200
#SBATCH --no-requeue

set -euo pipefail
source "{REPO}/slurm/common.sh"
mamba activate "$ASYS_HARNESS_ENV"

# Cell jobs are HTTP clients to the vLLM servers (no GPU needed here).
exec python -m agents_scaling.experiment.run_one \
  --run-id "{RUN_ID}" \
  --cells-file "{CELLS_FILE}" \
  --index "$SLURM_ARRAY_TASK_ID"
