#!/bin/bash
#SBATCH --job-name=asys-study-loop-driver
#SBATCH --partition=mit_normal,mit_preemptable
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=12:00:00
#SBATCH --output=/orcd/data/tpoggio/001/mabdel03/agents_scaling_results/study_v4/logs/study_loop_driver_%j.out

# study_v4 chunk-driver loop (WP5): runs study_launch_chunked.py for every lane of this
# run as a SLURM job (never a login-node nohup), self-resubmitting with afterany so a
# walltime expiry is a baton pass.  NEVER add --requeue (chain duplication; see
# launch_loops.py).  The per-lane drivers are resumable: run_one skips cells with meta.json.
set -euo pipefail
if [[ "${ASYS_ALLOW_LEGACY_CONTROL:-0}" != "1" ]]; then
  echo "[retired] study loop driver requires ASYS_ALLOW_LEGACY_CONTROL=1" >&2
  exit 2
fi
source "/orcd/data/tpoggio/001/mabdel03/agents_scaling/slurm/common.sh"
mamba activate "$ASYS_HARNESS_ENV"

if [ -z "${NO_RESUBMIT:-}" ]; then
  sbatch --dependency=afterany:$SLURM_JOB_ID "/orcd/data/tpoggio/001/mabdel03/agents_scaling/slurm/study_loop_driver.sbatch.study_v4" \
    && echo "[self-resubmit] queued successor with dependency on $SLURM_JOB_ID" \
    || echo "[self-resubmit] WARNING: failed to queue successor"
fi

cd "/orcd/data/tpoggio/001/mabdel03/agents_scaling"
# One driver per lane, in parallel; each keeps its own array name/throttle (P0-7).
# Drivers exit once every chunk of their manifest is dispatched or complete, so the loop
# re-runs them every 15 min (idempotent: complete / in-flight chunks are skipped) instead of
# handing the baton to a successor job every minute.  The 32B lane runs tier 1 to
# dispatch completion before tier 2 (cells_2_32B.json, throttle 30) and then tier 3
# (8B M-cross cells_3_8B.json, then cells_3_32B.json throttle 15; Mon 06:00 hard stop cancels
# what remains).  Tier 2/3 use 50-cell chunks so they trickle in as QOS room frees.
for _iter in $(seq 1 40); do
  echo "[loop] iteration $_iter $(date)"
  ( python -u slurm/study_launch_chunked.py --allow-legacy-admission --run-id "study_v4" --server-run-id "study_v4" --cells-file "cells_1_32B.json" --lane 32B --chunk-size 100 --throttle 40 --submit-cap 380 --qos-limit 460 --cell-partition "mit_preemptable" --cell-time "1-00:00:00" --cell-mem "4G" --cpus 1 --poll-s 120.0 ; python -u slurm/study_launch_chunked.py --allow-legacy-admission --run-id "study_v4" --server-run-id "study_v4" --cells-file "cells_2_32B.json" --lane 32B --chunk-size 50 --throttle 20 --submit-cap 380 --qos-limit 460 --cell-partition "mit_preemptable" --cell-time "1-00:00:00" --cell-mem "4G" --cpus 1 --poll-s 120.0 ; python -u slurm/study_launch_chunked.py --allow-legacy-admission --run-id "study_v4" --server-run-id "study_v4" --cells-file "cells_3_8B.json" --lane 8B --chunk-size 60 --throttle 24 --submit-cap 380 --qos-limit 460 --cell-partition "mit_preemptable" --cell-time "1-00:00:00" --cell-mem "4G" --cpus 1 --poll-s 120.0 ; python -u slurm/study_launch_chunked.py --allow-legacy-admission --run-id "study_v4" --server-run-id "study_v4" --cells-file "cells_3_32B.json" --lane 32B --chunk-size 50 --throttle 15 --submit-cap 380 --qos-limit 460 --cell-partition "mit_preemptable" --cell-time "1-00:00:00" --cell-mem "4G" --cpus 1 --poll-s 120.0 ) &
  python -u slurm/study_launch_chunked.py --allow-legacy-admission --run-id "study_v4" --server-run-id "study_v4" --cells-file "cells_2_14B.json" --lane 14B --chunk-size 100 --throttle 18 --submit-cap 380 --qos-limit 460 --cell-partition "mit_preemptable" --cell-time "1-00:00:00" --cell-mem "4G" --cpus 1 --poll-s 120.0 &
  ( python -u slurm/study_launch_chunked.py --allow-legacy-admission --run-id "study_v4" --server-run-id "study_v4" --cells-file "cells_2_8B.json" --lane 8B --chunk-size 100 --throttle 24 --submit-cap 380 --qos-limit 460 --cell-partition "mit_preemptable" --cell-time "1-00:00:00" --cell-mem "4G" --cpus 1 --poll-s 120.0 ) &
  python -u slurm/study_launch_chunked.py --allow-legacy-admission --run-id "study_v4" --server-run-id "study_v4" --cells-file "cells_2_4B.json" --lane 4B --chunk-size 100 --throttle 12 --submit-cap 380 --qos-limit 460 --cell-partition "mit_preemptable" --cell-time "1-00:00:00" --cell-mem "4G" --cpus 1 --poll-s 120.0 &
  wait || true
  sleep 900
done
