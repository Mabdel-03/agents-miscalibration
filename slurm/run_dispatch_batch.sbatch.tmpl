#!/bin/bash
#SBATCH --job-name=asys-dispatch-{BATCH_TAG}
#SBATCH --comment=asys-schema5-intent:{BATCH_ID}
#SBATCH --partition={PARTITION}
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=12:00:00
#SBATCH --array=0-{LAST_INDEX}%{THROTTLE}
#SBATCH --output={LOG_DIR}/dispatch_%A_%a.out
#SBATCH --signal=B:USR1@1200
#SBATCH --no-requeue

set -euo pipefail
{RUNTIME_SETUP}

# The global dispatcher can mix runs and model profiles in one small array.  Its batch
# manifest maps this local index back to the immutable run manifest and verifies both the
# manifest checksum and cell config hash before the runner starts.
exec {PYTHON} -u {DISPATCH_SCRIPT} run-task \
  --batch-manifest "{BATCH_MANIFEST}" \
  --index "$SLURM_ARRAY_TASK_ID"{RUNTIME_ARGUMENTS}
